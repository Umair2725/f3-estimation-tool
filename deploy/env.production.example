# Production settings for deploy/compose.yaml. Copy this file to deploy/.env.production on the
# server and fill it in there. Never commit the filled-in file or paste its values into chat,
# tickets or email. The app refuses to start, naming the setting, if one is missing or wrong.

# --- Database (IT's managed PostgreSQL 17 with the vector and pg_trgm extensions) ---
# Database name: f3_estimation. Add ?sslmode=require if IT's server requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/f3_estimation?sslmode=require

# --- Address and sign-in ---
# The domain Caddy serves and gets an HTTPS certificate for (its DNS must point at this server).
APP_DOMAIN=estimates.folio3.com
# The public address, exactly as people open it (https, no trailing slash).
AUTH_URL=https://estimates.folio3.com
# At least 32 random characters. Generate a new one for production; never reuse the local one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google OAuth client (the same client as local, with the production address added to it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# @folio3.com addresses that become Admin on first sign-in (comma-separated).
ADMIN_EMAILS=

# --- Email (optional; empty SMTP_HOST = no email) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Claude (optional; empty = document reading and AI estimates are off) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Other ---
LOG_LEVEL=info
