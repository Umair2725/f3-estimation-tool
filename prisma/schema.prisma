// F3 Estimation Tool database schema.
// The connection URL comes from prisma.config.ts (DATABASE_URL); see .env.example.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Sign-in and roles (specs/authentication, specs/user-roles) ----------
// User, Session, Account and Verification follow Better Auth's expected shape; role, status
// and lastActiveAt are our additional user fields.

enum Role {
  ESTIMATOR
  TECH_LEAD
  ARCHITECT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  role          Role?
  status        UserStatus @default(ACTIVE)
  lastActiveAt  DateTime?  @map("last_active_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  invitations RoleInvitation[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// A role pre-assigned by an Admin to a @folio3.com email before that person first signs in.
model RoleInvitation {
  email       String   @id // stored lowercased
  role        Role
  invitedById String   @map("invited_by_id")
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("role_invitation")
}

// Small key/value table for application metadata (e.g. schema label).
// Business tables arrive with later changes.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}
