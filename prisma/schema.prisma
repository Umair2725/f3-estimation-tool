// F3 Estimation Tool database schema.
// The connection URL comes from prisma.config.ts (DATABASE_URL); see .env.example.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Sign-in and roles (specs/authentication, specs/user-roles) ----------
// User, Session, Account and Verification follow Better Auth's expected shape; role, status
// and lastActiveAt are our additional user fields.

enum Role {
  ESTIMATOR
  TECH_LEAD
  ARCHITECT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  role          Role?
  status        UserStatus @default(ACTIVE)
  lastActiveAt  DateTime?  @map("last_active_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions        Session[]
  accounts        Account[]
  invitations     RoleInvitation[]
  requests        EstimationRequest[] @relation("requestOwner")
  reviewing       EstimationRequest[] @relation("requestReviewer")
  statusChanges   StatusChange[]
  reviewComments  ReviewComment[]
  approvals       ApprovedVersion[]
  notifications   Notification[]      @relation("notificationUser")
  notified        Notification[]      @relation("notificationActor")
  exports         ExportRecord[]
  actuals         ActualsVersion[]
  uploads         ActualsUpload[]
  files           UploadedFile[]
  importBatches   ImportBatch[]
  importDecisions ImportedProject[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// A role pre-assigned by an Admin to a @folio3.com email before that person first signs in.
model RoleInvitation {
  email       String   @id // stored lowercased
  role        Role
  invitedById String   @map("invited_by_id")
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("role_invitation")
}

// Small key/value table for application metadata (e.g. schema label).
// Business tables arrive with later changes.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------- Estimation requests (specs/estimation-requests, specs/tech-stack-catalog) ----------

enum RequestStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  EXPORTED
}

// One development sheet each in the Excel template.
enum ProjectPart {
  BACKEND
  WEB_FRONTEND
  ADMIN_PANEL
  MOBILE
  CLOUD_INFRA
}

model Client {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique @map("name_key") // lowercased, trimmed, inner spaces collapsed
  createdAt DateTime @default(now()) @map("created_at")

  requests EstimationRequest[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_name_trgm_idx")
  @@map("client")
}

model EstimationRequest {
  id                 String         @id @default(uuid())
  projectName        String         @map("project_name")
  clientId           String?        @map("client_id")
  client             Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectManager     String         @map("project_manager")
  projectDate        DateTime       @map("project_date") @db.Date
  status             RequestStatus  @default(DRAFT)
  ownerId            String         @map("owner_id")
  owner              User           @relation("requestOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  lastStep           Int            @default(1) @map("last_step")
  applicationTypes   String[]       @map("application_types")
  operatingSystems   String[]       @map("operating_systems")
  browsers           String[]
  considerations     Json           @default("{}") // validated by src/lib/estimation/schemas.ts
  // Overheads and price (specs/estimate-hours); new requests copy EstimateDefaults.
  qaPercent          Int            @default(25) @map("qa_percent")
  qaEnabled          Boolean        @default(true) @map("qa_enabled")
  pmPercent          Int            @default(30) @map("pm_percent")
  pmEnabled          Boolean        @default(true) @map("pm_enabled")
  bugFixPercent      Int            @default(10) @map("bug_fix_percent")
  hourlyRate         Int            @default(30) @map("hourly_rate") // USD per hour
  rateConfirmed      Boolean        @default(false) @map("rate_confirmed")
  // What happened after the estimate (specs/project-outcome); separate from the review status.
  outcome            ProjectOutcome @default(NONE)
  outcomeReason      String?        @map("outcome_reason")
  outcomeChangedAt   DateTime?      @map("outcome_changed_at")
  outcomeChangedById String?        @map("outcome_changed_by_id")
  // Imported past projects are historical, pre-AI baselines (specs/historical-import).
  origin             RequestOrigin  @default(NEW)
  baseline           HoursBaseline  @default(AI_ERA)
  // Review and approval (specs/estimate-review).
  version            Int            @default(1)
  reviewerId         String?        @map("reviewer_id")
  reviewer           User?          @relation("requestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  submittedAt        DateTime?      @map("submitted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  parts          RequestPart[]
  features       Feature[]
  exports        ExportRecord[]
  actuals        ActualsVersion[]
  actualsUploads ActualsUpload[]
  importedFrom   ImportedProject[]
  statusChanges  StatusChange[]
  comments       ReviewComment[]
  approved       ApprovedVersion[]
  notifications  Notification[]

  @@index([updatedAt(sort: Desc)])
  @@index([reviewerId, status])
  @@index([ownerId, status])
  @@index([projectName(ops: raw("gin_trgm_ops"))], type: Gin, map: "estimation_request_project_name_trgm_idx")
  @@map("estimation_request")
}

model RequestPart {
  id                  String                  @id @default(uuid())
  requestId           String                  @map("request_id")
  request             EstimationRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part                ProjectPart
  technologies        RequestPartTechnology[]
  tasks               EstimateTask[]
  actualHours         ActualHours[]
  // Per development sheet; hours in tenths of an hour.
  deploymentMinTenths Int                     @default(0) @map("deployment_min_tenths")
  deploymentMaxTenths Int                     @default(0) @map("deployment_max_tenths")
  assumptions         String[]
  risks               String[]

  @@unique([requestId, part])
  @@map("request_part")
}

model RequestPartTechnology {
  requestPartId String      @map("request_part_id")
  requestPart   RequestPart @relation(fields: [requestPartId], references: [id], onDelete: Cascade)
  technologyId  String      @map("technology_id")
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([requestPartId, technologyId])
  @@index([technologyId])
  @@map("request_part_technology")
}

model Technology {
  id        String        @id @default(uuid())
  name      String
  nameKey   String        @unique @map("name_key")
  parts     ProjectPart[]
  retiredAt DateTime?     @map("retired_at")
  createdAt DateTime      @default(now()) @map("created_at")

  usedBy RequestPartTechnology[]

  @@map("technology")
}

model Feature {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parts       ProjectPart[]
  position    Int
  tasks       EstimateTask[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([requestId, position])
  @@map("feature")
}

// ---------- Estimate hours and export (specs/estimate-hours, specs/excel-export, specs/estimate-defaults) ----------

// One per feature × part: a Task on that part's development sheet. Name and order come from the feature.
model EstimateTask {
  id            String          @id @default(uuid())
  featureId     String          @map("feature_id")
  feature       Feature         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  requestPartId String          @map("request_part_id")
  requestPart   RequestPart     @relation(fields: [requestPartId], references: [id], onDelete: Cascade)
  subTasks      SubTask[]
  comments      ReviewComment[]

  @@unique([featureId, requestPartId])
  @@index([requestPartId])
  @@map("estimate_task")
}

model SubTask {
  id           String          @id @default(uuid())
  taskId       String          @map("task_id")
  task         EstimateTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title        String
  minTenths    Int             @map("min_tenths") // hours × 10, exact
  maxTenths    Int             @map("max_tenths")
  comment      String          @default("")
  position     Int
  actuals      ActualHours[]
  // Where an imported Sub task came from (specs/historical-import).
  sourceFileId String?         @map("source_file_id")
  sourceFile   UploadedFile?   @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  sourceSheet  String?         @map("source_sheet")
  sourceRow    Int?            @map("source_row")
  comments     ReviewComment[]

  @@index([taskId, position])
  @@map("sub_task")
}

// A single row (id "default") holding what new requests start from.
model EstimateDefaults {
  id            String   @id @default("default")
  qaPercent     Int      @default(25) @map("qa_percent")
  pmPercent     Int      @default(30) @map("pm_percent")
  bugFixPercent Int      @default(10) @map("bug_fix_percent")
  defaultRate   Int      @default(30) @map("default_rate")
  approvedRates Int[]    @default([25, 30, 35, 40, 45, 50]) @map("approved_rates")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedById   String?  @map("updated_by_id")

  @@map("estimate_defaults")
}

enum ExportKind {
  INTERNAL
  CLIENT
}

model ExportRecord {
  id        String            @id @default(uuid())
  requestId String            @map("request_id")
  request   EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      ExportKind
  fileName  String            @map("file_name")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([requestId, createdAt(sort: Desc)])
  @@map("export_record")
}

// ---------- Outcome and actual hours (specs/project-outcome, specs/actual-hours) ----------

enum ProjectOutcome {
  NONE
  IN_DELIVERY
  LOST
  DELIVERED
}

enum ActualsSource {
  MANUAL
  FILE
}

enum ActualStatus {
  MATCHED
  UNPLANNED
  DROPPED
}

// One saved set of actual hours; the highest number is the request's current actuals.
model ActualsVersion {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  number      Int
  source      ActualsSource
  fileName    String?           @map("file_name")
  fileBytes   Bytes?            @map("file_bytes")
  fingerprint String?
  createdById String            @map("created_by_id")
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  rows        ActualHours[]

  @@unique([requestId, number])
  @@map("actuals_version")
}

// One row per estimated Sub task (matched or dropped) and per unplanned row. The estimate is
// copied in so a version's report never changes when the estimate is edited later.
model ActualHours {
  id            String         @id @default(uuid())
  versionId     String         @map("version_id")
  version       ActualsVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subTaskId     String?        @map("sub_task_id")
  subTask       SubTask?       @relation(fields: [subTaskId], references: [id], onDelete: SetNull)
  requestPartId String?        @map("request_part_id")
  requestPart   RequestPart?   @relation(fields: [requestPartId], references: [id], onDelete: SetNull)
  partLabel     String         @map("part_label")
  taskTitle     String         @map("task_title")
  title         String
  estMinTenths  Int            @default(0) @map("est_min_tenths")
  estMaxTenths  Int            @default(0) @map("est_max_tenths")
  actualTenths  Int?           @map("actual_tenths")
  status        ActualStatus
  similarity    Float?
  flags         String[]
  sourceSheet   String?        @map("source_sheet")
  sourceRow     Int?           @map("source_row")
  position      Int

  @@index([versionId, position])
  @@index([subTaskId])
  @@map("actual_hours")
}

// An uploaded actuals file waiting for its preview to be confirmed (expires after a day).
model ActualsUpload {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName    String            @map("file_name")
  fileBytes   Bytes             @map("file_bytes")
  fingerprint String
  parsed      Json
  createdById String            @map("created_by_id")
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at")
  expiresAt   DateTime          @map("expires_at")

  @@map("actuals_upload")
}

// ---------- Historical import (specs/historical-import) ----------

enum RequestOrigin {
  NEW
  IMPORTED
}

enum HoursBaseline {
  AI_ERA
  PRE_AI
}

enum UploadedFileKind {
  ESTIMATE
  ACTUALS
}

enum ImportStatus {
  READY
  FAILED
  APPROVED
  REJECTED
  SKIPPED
}

// Every imported file, identified by content, never by name.
model UploadedFile {
  id           String           @id @default(uuid())
  fileName     String           @map("file_name")
  bytes        Bytes
  fingerprint  String
  kind         UploadedFileKind
  uploadedById String           @map("uploaded_by_id")
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @map("created_at")

  subTasks    SubTask[]
  estimateFor ImportedProject[] @relation("estimateFile")
  actualsFor  ImportedProject[] @relation("actualsFile")

  @@index([fingerprint])
  @@map("uploaded_file")
}

model ImportBatch {
  id          String            @id @default(uuid())
  sourceName  String            @map("source_name")
  notes       String[]
  createdById String            @map("created_by_id")
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")
  projects    ImportedProject[]

  @@map("import_batch")
}

model ImportedProject {
  id             String             @id @default(uuid())
  batchId        String             @map("batch_id")
  batch          ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  folder         String
  position       Int
  estimateFileId String?            @map("estimate_file_id")
  estimateFile   UploadedFile?      @relation("estimateFile", fields: [estimateFileId], references: [id], onDelete: SetNull)
  actualsFileId  String?            @map("actuals_file_id")
  actualsFile    UploadedFile?      @relation("actualsFile", fields: [actualsFileId], references: [id], onDelete: SetNull)
  status         ImportStatus
  failure        String?
  parsed         Json?
  actualsParsed  Json?              @map("actuals_parsed")
  decisions      Json               @default("{}")
  duplicate      Json?
  requestId      String?            @map("request_id")
  request        EstimationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  decidedById    String?            @map("decided_by_id")
  decidedBy      User?              @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?          @map("decided_at")

  @@index([batchId, position])
  @@map("imported_project")
}

// ---------- Review and approval (specs/estimate-review) ----------

model StatusChange {
  id         String            @id @default(uuid())
  requestId  String            @map("request_id")
  request    EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus RequestStatus?    @map("from_status")
  toStatus   RequestStatus     @map("to_status")
  version    Int
  actorId    String            @map("actor_id")
  actor      User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  comment    String?
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("status_change")
}

model ReviewComment {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId    String            @map("author_id")
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  version     Int
  body        String
  // A Task or Sub task target; the title is kept so the comment stays readable after removal.
  taskId      String?           @map("task_id")
  task        EstimateTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subTaskId   String?           @map("sub_task_id")
  subTask     SubTask?          @relation(fields: [subTaskId], references: [id], onDelete: SetNull)
  targetTitle String?           @map("target_title")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("review_comment")
}

// The frozen estimate at approval; the latest one is the knowledge-base source.
model ApprovedVersion {
  id           String            @id @default(uuid())
  requestId    String            @map("request_id")
  request      EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json // src/lib/review/snapshot.ts
  approvedById String            @map("approved_by_id")
  approvedBy   User              @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime          @default(now()) @map("approved_at")

  @@unique([requestId, version])
  @@map("approved_version")
}

enum NotificationKind {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model Notification {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  user      User              @relation("notificationUser", fields: [userId], references: [id], onDelete: Cascade)
  requestId String            @map("request_id")
  request   EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  actorId   String            @map("actor_id")
  actor     User              @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  readAt    DateTime?         @map("read_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notification")
}
