// F3 Estimation Tool database schema.
// The connection URL comes from prisma.config.ts (DATABASE_URL); see .env.example.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Sign-in and roles (specs/authentication, specs/user-roles) ----------
// User, Session, Account and Verification follow Better Auth's expected shape; role, status
// and lastActiveAt are our additional user fields.

enum Role {
  ESTIMATOR
  TECH_LEAD
  ARCHITECT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  role          Role?
  status        UserStatus @default(ACTIVE)
  lastActiveAt  DateTime?  @map("last_active_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  invitations RoleInvitation[]
  requests    EstimationRequest[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// A role pre-assigned by an Admin to a @folio3.com email before that person first signs in.
model RoleInvitation {
  email       String   @id // stored lowercased
  role        Role
  invitedById String   @map("invited_by_id")
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("role_invitation")
}

// Small key/value table for application metadata (e.g. schema label).
// Business tables arrive with later changes.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------- Estimation requests (specs/estimation-requests, specs/tech-stack-catalog) ----------

enum RequestStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  EXPORTED
}

// One development sheet each in the Excel template.
enum ProjectPart {
  BACKEND
  WEB_FRONTEND
  ADMIN_PANEL
  MOBILE
  CLOUD_INFRA
}

model Client {
  id        String   @id @default(uuid())
  name      String
  nameKey   String   @unique @map("name_key") // lowercased, trimmed, inner spaces collapsed
  createdAt DateTime @default(now()) @map("created_at")

  requests EstimationRequest[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_name_trgm_idx")
  @@map("client")
}

model EstimationRequest {
  id               String        @id @default(uuid())
  projectName      String        @map("project_name")
  clientId         String?       @map("client_id")
  client           Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectManager   String        @map("project_manager")
  projectDate      DateTime      @map("project_date") @db.Date
  status           RequestStatus @default(DRAFT)
  ownerId          String        @map("owner_id")
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  lastStep         Int           @default(1) @map("last_step")
  applicationTypes String[]      @map("application_types")
  operatingSystems String[]      @map("operating_systems")
  browsers         String[]
  considerations   Json          @default("{}") // validated by src/lib/estimation/schemas.ts
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  parts    RequestPart[]
  features Feature[]

  @@index([updatedAt(sort: Desc)])
  @@index([ownerId, status])
  @@index([projectName(ops: raw("gin_trgm_ops"))], type: Gin, map: "estimation_request_project_name_trgm_idx")
  @@map("estimation_request")
}

model RequestPart {
  id           String                  @id @default(uuid())
  requestId    String                  @map("request_id")
  request      EstimationRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  part         ProjectPart
  technologies RequestPartTechnology[]

  @@unique([requestId, part])
  @@map("request_part")
}

model RequestPartTechnology {
  requestPartId String      @map("request_part_id")
  requestPart   RequestPart @relation(fields: [requestPartId], references: [id], onDelete: Cascade)
  technologyId  String      @map("technology_id")
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([requestPartId, technologyId])
  @@index([technologyId])
  @@map("request_part_technology")
}

model Technology {
  id        String        @id @default(uuid())
  name      String
  nameKey   String        @unique @map("name_key")
  parts     ProjectPart[]
  retiredAt DateTime?     @map("retired_at")
  createdAt DateTime      @default(now()) @map("created_at")

  usedBy RequestPartTechnology[]

  @@map("technology")
}

model Feature {
  id          String            @id @default(uuid())
  requestId   String            @map("request_id")
  request     EstimationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parts       ProjectPart[]
  position    Int
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([requestId, position])
  @@map("feature")
}
