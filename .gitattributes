# Store text files with LF line endings in the repository, whatever the OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings.
*.xlsx binary
*.docx binary
*.pdf binary
*.png binary
*.ico binary
