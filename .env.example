# Copy this file to .env and adjust. Never commit .env.
# Every setting is checked at startup (npm run check-env); the app refuses to start if one is missing or invalid.

# PostgreSQL connection (required). Must start with postgres:// or postgresql://.
# This default matches the "db" service in compose.yaml when the app runs on your machine (npm run dev).
DATABASE_URL=postgresql://f3:f3_local_password@localhost:5432/f3_estimation
# Optional: the database the automated tests use. Empty = f3_test on the same server as
# DATABASE_URL (created, migrated and seeded before each run). Tests never use DATABASE_URL's
# database, because it holds real work.
TEST_DATABASE_URL=

# development | test | production (optional, default: development)
NODE_ENV=development

# debug | info | warn | error (optional, default: info)
LOG_LEVEL=info

# --- Sign-in ---
# Random secret, at least 32 characters. DEVELOPMENT VALUE ONLY: never use it anywhere shared.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public address of the app.
AUTH_URL=http://localhost:3000
# Google OAuth client (required unless AUTH_DEV_LOGIN=1 outside production). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated @folio3.com emails that become Admin on first sign-in.
ADMIN_EMAILS=khanumair@folio3.com
# 1 = development sign-in with seeded test users (refused in production). 0 = Google only.
AUTH_DEV_LOGIN=1
# Password for the seeded development users (npm run db:seed). DEVELOPMENT ONLY.
DEV_USER_PASSWORD=dev-password-not-for-production

# --- Matching (feature suggestions) ---
# local = a small open-source embedding model on this server (downloaded once, then cached).
# stub = test-only vectors, no download. Optional, default: local.
EMBEDDINGS_PROVIDER=local
# Where the embedding model is cached (optional, default: ./.cache/models).
EMBEDDINGS_CACHE_DIR=
# Optional: an Anthropic API key turns on clearly labelled AI guesses for features with no
# reliable match. Put it here only, never in chat or in git. Empty = AI guesses are off.
ANTHROPIC_API_KEY=
# Optional Claude model for AI guesses (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# Email (optional). Empty SMTP_HOST = no email is sent; the app works as before.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER and MAIL_FROM = the Gmail address,
# SMTP_PASSWORD = a Google app password (see README "Email"). Put it here only, never in chat or git.
SMTP_HOST=
# Optional, default 465.
SMTP_PORT=
# Optional: true = TLS from the start, false = STARTTLS. Empty = true on port 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Requirement documents are read by Claude (needs ANTHROPIC_API_KEY). stub = test-only reader,
# refused in production. Optional, default: claude.
DOCUMENT_READER=

# AI guesses use Claude (needs ANTHROPIC_API_KEY). stub = test-only guess, refused in production.
# Optional, default: claude.
AI_GUESS=
