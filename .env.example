# Copy this file to .env and adjust. Never commit .env.
# Every setting is checked at startup (npm run check-env); the app refuses to start if one is missing or invalid.

# PostgreSQL connection (required). Must start with postgres:// or postgresql://.
# This default matches the "db" service in compose.yaml when the app runs on your machine (npm run dev).
DATABASE_URL=postgresql://f3:f3_local_password@localhost:5432/f3_estimation

# development | test | production (optional, default: development)
NODE_ENV=development

# debug | info | warn | error (optional, default: info)
LOG_LEVEL=info

# --- Sign-in ---
# Random secret, at least 32 characters. DEVELOPMENT VALUE ONLY: never use it anywhere shared.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public address of the app.
AUTH_URL=http://localhost:3000
# Google OAuth client (required unless AUTH_DEV_LOGIN=1 outside production). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated @folio3.com emails that become Admin on first sign-in.
ADMIN_EMAILS=khanumair@folio3.com
# 1 = development sign-in with seeded test users (refused in production). 0 = Google only.
AUTH_DEV_LOGIN=1
# Password for the seeded development users (npm run db:seed). DEVELOPMENT ONLY.
DEV_USER_PASSWORD=dev-password-not-for-production
